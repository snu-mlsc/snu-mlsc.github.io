---
// 히어로에 들어가는 작은 수치 시뮬레이션.
// 정상 비압축 흐름(Taylor–Green) 위에서 스칼라장을 이류·확산시켜.
//   c_t + u·∇c = ν Δc
// 색은 viridis. 사이트 팔레트와 같은 colormap 이야.
import Equation from './Equation.astro';
---
<figure class="field">
  <canvas id="field" width="240" height="150" aria-hidden="true"></canvas>
  <figcaption>
    <Equation formula="c_t + u \\cdot \\nabla c = \\nu\\, \\Delta c" />
    <span class="note">a passive scalar stirred by a steady vortex lattice, integrated in your browser</span>
  </figcaption>
</figure>

<style>
  .field { margin: 0; display: grid; gap: 0.9rem; }
  canvas {
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    display: block;
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }
  figcaption { display: grid; gap: 0.3rem; }
  .note { font-size: var(--step--1); color: var(--ink-3); line-height: 1.5; }
</style>

<script>
  const canvas = document.getElementById('field') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const NX = canvas.width;
    const NY = canvas.height;

    // --- viridis lookup table -------------------------------------------
    const anchors: [number, number, number][] = [
      [68, 1, 84], [72, 40, 120], [62, 74, 137], [49, 104, 142],
      [38, 130, 142], [31, 158, 137], [53, 183, 121], [109, 205, 89], [253, 231, 37],
    ];
    const LUT = new Uint8ClampedArray(256 * 3);
    for (let i = 0; i < 256; i++) {
      const t = (i / 255) * (anchors.length - 1);
      const k = Math.min(Math.floor(t), anchors.length - 2);
      const f = t - k;
      for (let ch = 0; ch < 3; ch++) {
        LUT[i * 3 + ch] = anchors[k][ch] * (1 - f) + anchors[k + 1][ch] * f;
      }
    }

    // --- state ------------------------------------------------------------
    const N = NX * NY;
    let c = new Float32Array(N);
    let next = new Float32Array(N);
    const ux = new Float32Array(N);
    const uy = new Float32Array(N);

    const TAU = Math.PI * 2;
    for (let j = 0; j < NY; j++) {
      for (let i = 0; i < NX; i++) {
        const x = i / NX, y = j / NY;
        // streamfunction ψ = sin(2πx) sin(2πy)  →  u = (∂ψ/∂y, −∂ψ/∂x)
        ux[j * NX + i] = Math.sin(TAU * x) * Math.cos(TAU * y);
        uy[j * NX + i] = -Math.cos(TAU * x) * Math.sin(TAU * y);
      }
    }

    const blob = (cx: number, cy: number, r: number, amp: number) => {
      for (let j = 0; j < NY; j++) {
        for (let i = 0; i < NX; i++) {
          const dx = (i - cx) / NX, dy = (j - cy) / NY;
          c[j * NX + i] += amp * Math.exp(-(dx * dx + dy * dy) / (2 * r * r));
        }
      }
    };
    const seed = () => {
      blob(NX * 0.28, NY * 0.34, 0.1, 1);
      blob(NX * 0.7, NY * 0.68, 0.09, 0.9);
      blob(NX * 0.55, NY * 0.2, 0.06, 0.7);
    };
    seed();

    const NU = 0.35;      // 확산 계수 (격자 단위)
    const DT = 0.18;
    const SPEED = 1.1;

    const step = () => {
      for (let j = 0; j < NY; j++) {
        const jm = ((j - 1) + NY) % NY, jp = (j + 1) % NY;
        for (let i = 0; i < NX; i++) {
          const im = ((i - 1) + NX) % NX, ip = (i + 1) % NX;
          const k = j * NX + i;
          const vx = ux[k] * SPEED, vy = uy[k] * SPEED;
          // 1차 풍상차분 이류
          const dcx = vx > 0 ? c[k] - c[j * NX + im] : c[j * NX + ip] - c[k];
          const dcy = vy > 0 ? c[k] - c[jm * NX + i] : c[jp * NX + i] - c[k];
          // 5점 라플라시안 확산
          const lap = c[j * NX + im] + c[j * NX + ip] + c[jm * NX + i] + c[jp * NX + i] - 4 * c[k];
          next[k] = c[k] + DT * (-(vx * dcx + vy * dcy) + NU * lap);
        }
      }
      const t = c; c = next; next = t;
    };

    const image = ctx!.createImageData(NX, NY);
    const px = image.data;
    const draw = () => {
      let max = 1e-6;
      for (let k = 0; k < N; k++) if (c[k] > max) max = c[k];
      for (let k = 0; k < N; k++) {
        const v = Math.min(1, Math.max(0, c[k] / max));
        const idx = (v * 255) | 0;
        px[k * 4] = LUT[idx * 3];
        px[k * 4 + 1] = LUT[idx * 3 + 1];
        px[k * 4 + 2] = LUT[idx * 3 + 2];
        // 값이 작은 곳은 종이가 비쳐 보이게
        px[k * 4 + 3] = 255 * Math.min(1, Math.pow(v, 0.75) * 1.15);
      }
      ctx!.clearRect(0, 0, NX, NY);
      ctx!.putImageData(image, 0, 0);
    };

    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (still.matches) {
      for (let s = 0; s < 220; s++) step();
      draw();
    } else {
      let frames = 0;
      let running = true;
      const loop = () => {
        if (!running) return;
        for (let s = 0; s < 2; s++) step();
        // 확산으로 다 섞이기 전에 새 blob 을 주입해서 무늬가 계속 살아있게
        if (++frames % 260 === 0) {
          blob(Math.random() * NX, Math.random() * NY, 0.05 + Math.random() * 0.05, 0.8);
        }
        draw();
        requestAnimationFrame(loop);
      };
      // 화면 밖으로 나가면 멈춤
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !running) { running = true; loop(); }
        else if (!e.isIntersecting) { running = false; }
      });
      io.observe(canvas);
      loop();
    }
  }
</script>
