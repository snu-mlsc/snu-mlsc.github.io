---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const items = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

// 랩 구글 캘린더. 다른 캘린더로 바꾸려면 이 주소만 갈아끼우면 돼.
const calendar = 'https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=Asia%2FSeoul&mode=MONTH&title=MLSC&showCalendars=0&showPrint=0&src=Y184YWFiNGQxZmFlODhhYmY2NDYxNWYwMDMzYWExNWY1ODdkM2I2NjY3YTIwZWI0NGVjNWY0N2NlNWM3OWFmZDQ2QGdyb3VwLmNhbGVuZGFyLmdvb2dsZS5jb20&src=a28uc291dGhfa29yZWEjaG9saWRheUBncm91cC52LmNhbGVuZGFyLmdvb2dsZS5jb20&color=%23414487&color=%232A788E';
---
<Base title="News & events — MLSC Lab">
  <section class="section wrap head">
    <p class="eyebrow">News &amp; events</p>
    <h1>What's happening in the group</h1>
  </section>

  <hr class="rule" />

  <section class="section wrap">
    {items.length === 0 && <p class="empty">Nothing posted yet. Add a Markdown file to <code>src/content/news/</code> to start the log.</p>}
    <ul class="list">
      {items.map((n) => (
        <li>
          <div class="meta">
            <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
            <span class="kind">{n.data.kind}</span>
          </div>
          <div>
            <h2><a href={`/news/${n.id}/`}>{n.data.title}</a></h2>
            {n.data.summary && <p>{n.data.summary}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <hr class="rule" />

  <section class="section wrap">
    <p class="eyebrow">Lab calendar</p>
    <div class="cal">
      <iframe src={calendar} title="MLSC Lab calendar" loading="lazy" style="border:0" frameborder="0" scrolling="no"></iframe>
    </div>
  </section>
</Base>

<style>
  .head h1 { font-size: var(--step-3); }
  .empty { color: var(--ink-3); }
  .empty code { font-family: var(--font-mono); font-size: 0.9em; }
  .list { list-style: none; padding: 0; margin: 0; }
  .list li { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1.5rem; padding-block: 1.6rem; border-top: 1px solid var(--rule); }
  .list li:last-child { border-bottom: 1px solid var(--rule); }
  @media (max-width: 44rem) { .list li { grid-template-columns: 1fr; gap: 0.4rem; } }
  .meta { font-family: var(--font-mono); font-size: var(--step--1); line-height: 1.5; }
  .meta time { display: block; }
  .kind { color: var(--ink-3); }
  h2 { font-size: var(--step-1); margin-bottom: 0.4rem; }
  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .list p { color: var(--ink-2); font-size: var(--step--1); margin: 0; }
  .cal { border: 1px solid var(--rule); aspect-ratio: 4 / 3; max-height: 40rem; }
  .cal iframe { width: 100%; height: 100%; display: block; }
</style>
